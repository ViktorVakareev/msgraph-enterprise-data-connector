# Azure Entra ID app registration (Implementing-Graph_API.txt walkthrough).
# Required — authentication fails without these three:
AZURE_CLIENT_ID=your-application-client-id
AZURE_TENANT_ID=your-directory-tenant-id
AZURE_CLIENT_SECRET=your-client-secret-value

# Optional — needed once Step 2's fetchers call specific resources:
SHAREPOINT_SITE_ID=
ONEDRIVE_USER=
